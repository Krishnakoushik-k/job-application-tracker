# ============================================================================
# Job Application Tracker - environment configuration
#
# Copy this file to ".env" in the project root and replace every value.
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows cmd)
#
# ".env" is git-ignored. NEVER commit it.
#
# Format rules (the file is read by Docker Compose AND by Spring Boot):
#   - one KEY=value per line
#   - no quotes, no spaces around "=", no backslashes in values
# ============================================================================

# --- Database (used by Docker Compose to create the MySQL user, and by the backend) ---
DB_USERNAME=jobtracker_user
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# JDBC URL used when you run the backend directly on your machine (not in Docker).
# Docker Compose overrides this automatically to point at the "mysql" container.
DB_URL=jdbc:mysql://localhost:3306/job_tracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- JWT ---
# Must be at least 32 characters. The backend refuses to start if it still begins with CHANGE_ME.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_EXPIRATION_MINUTES=60

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
# Not needed when the frontend proxies /api (Vite dev server, Docker Compose nginx),
# but required when the frontend is hosted on a different domain from the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Misc ---
# Time zone used to decide which interviews are "upcoming" and which month an application falls in.
# Any IANA zone id, e.g. Asia/Kolkata, UTC, America/New_York.
APP_TIMEZONE=Asia/Kolkata
# Hibernate schema handling. "none" = trust database/schema.sql. Do not use create/update in production.
DDL_AUTO=none
# Set to false in production to hide Swagger UI and /v3/api-docs.
SWAGGER_ENABLED=true

# --- Frontend build (Docker Compose build arg / hosting platform build variable) ---
# "/api" works when a reverse proxy forwards /api to the backend (Docker Compose does this).
# For a separately hosted backend use its full URL, e.g. https://your-api.example.com/api
VITE_API_BASE_URL=/api
